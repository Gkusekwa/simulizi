# Copy to .env and fill in. Never commit .env (it is gitignored). In Portainer, set
# these under the stack's "Environment variables" instead.
#
# Simulizi reuses the centrally managed nasinfra stack: one shared Postgres, one shared
# RustFS (S3), one shared Redis. Nothing here creates infrastructure -- the database role
# and the S3 bucket are provisioned by nasinfra, and the values below must match what it
# provisioned (nasinfra/.env: SIMULIZI_PASSWORD, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD).

NODE_ENV=production

# ---------------------------------------------------------------------------
# Public hostnames and host ports (see docker-compose.yml header)
# ---------------------------------------------------------------------------
WEB_PORT=3008
API_PORT=3009
PUBLIC_WEB_URL=https://simulizi.tzcom.cloud
PUBLIC_API_URL=https://simulizi-api.tzcom.cloud
# The web app calls the API cross-origin, so the API must allow the web origin.
CORS_ORIGINS=https://simulizi.tzcom.cloud

# ---------------------------------------------------------------------------
# Database -- shared Postgres 18 (nasinfra), role and database both `simulizi`
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=simulizi
DB_NAME=simulizi
# = nasinfra SIMULIZI_PASSWORD. Alphanumeric only: it travels through a DSN.
DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Jobs -- BullMQ on the shared Redis (nasinfra); RabbitMQ is not used
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Keep simulizi's keys apart from other apps on the same Redis.
REDIS_KEY_PREFIX=simulizi

# ---------------------------------------------------------------------------
# Object storage -- shared RustFS (nasinfra), bucket `simulizi`
# ---------------------------------------------------------------------------
# Internal endpoint the API uses (service alias on the nasinfra network).
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
# = nasinfra MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (shared storage credentials, as hazina;
# per-app RustFS users are a follow-up once an admin client is available).
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=simulizi
S3_REGION=us-east-1
# Host the BROWSER and the app reach for presigned URLs: the shared public storage
# hostname, path-style (https://storage.tzcom.cloud/simulizi/<key>).
S3_PUBLIC_ENDPOINT=storage.tzcom.cloud
S3_PUBLIC_PORT=443
S3_PUBLIC_USE_SSL=true

# ---------------------------------------------------------------------------
# Auth secrets  (generate each with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Firebase (email/Google sign-in and FCM push) -- familia's pattern
# ---------------------------------------------------------------------------
# Service-account JSON, MINIFIED to one line. Empty = push and social login disabled.
FIREBASE_SERVICE_ACCOUNT=
# Public web SDK config, minified to one line; baked into the web bundle at build time.
VITE_FIREBASE_CONFIG=

# ---------------------------------------------------------------------------
# Email -- Mailpit in development; the transactional provider is chosen in sprint 1
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Simulizi <no-reply@simulizi.tzcom.cloud>"
# The API reads SMTP_URL (built from SMTP_HOST/PORT by docker-compose.yml) and MAIL_FROM.

# ---------------------------------------------------------------------------
# Admin bootstrap -- the API promotes or creates this account on startup
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
